{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "^/autopilot",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/autopilot.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/autopilot.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
